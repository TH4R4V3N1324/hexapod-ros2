# RPLIDAR A2M12: give its CP2102 USB-serial adapter a fixed name, /dev/rplidar.
# Install on the Pi (the host, not the container):
#   sudo cp udev/99-rplidar.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Note: this matches any CP2102 adapter, so don't plug in another one alongside it.
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0666", SYMLINK+="rplidar"
