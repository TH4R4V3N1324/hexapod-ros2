<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="hexapod_world">

    <!-- Physics -->
    <physics name="1ms" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Harmonic system plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane with high friction for hexapod feet -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <bullet>
                <friction>2.0</friction>
                <friction2>2.0</friction2>
                <rolling_friction>0.1</rolling_friction>
              </bullet>
            </friction>
            <contact>
              <bullet>
                <kp>1e6</kp>
                <kd>100</kd>
              </bullet>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Indoor test house layout. Door openings are >= 1.0m for hexapod clearance. -->
    <model name="house_wall_north">
      <static>true</static>
      <pose>2.0 4.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.0 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.0 0.2 1.0</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="house_wall_south_left">
      <static>true</static>
      <pose>-0.5 -4.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.2 1.0</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="house_wall_south_right">
      <static>true</static>
      <pose>4.5 -4.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.2 1.0</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="house_wall_west">
      <static>true</static>
      <pose>-3.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 8.0 1.0</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="house_wall_east">
      <static>true</static>
      <pose>7.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 8.0 1.0</size></box></geometry><material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Interior walls with wide doorways (>= 1.0m) -->
    <model name="interior_wall_vertical_left_segment">
      <static>true</static>
      <pose>1.2 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 3.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 3.0 1.0</size></box></geometry><material><ambient>0.73 0.80 0.90 1</ambient><diffuse>0.73 0.80 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <model name="interior_wall_vertical_right_segment">
      <static>true</static>
      <pose>1.2 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 3.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 3.0 1.0</size></box></geometry><material><ambient>0.73 0.80 0.90 1</ambient><diffuse>0.73 0.80 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <model name="interior_wall_horizontal_top_left">
      <static>true</static>
      <pose>-0.9 1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.18 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.18 1.0</size></box></geometry><material><ambient>0.78 0.78 0.83 1</ambient><diffuse>0.78 0.78 0.83 1</diffuse></material></visual>
      </link>
    </model>

    <model name="interior_wall_horizontal_top_right">
      <static>true</static>
      <pose>3.4 1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.18 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.18 1.0</size></box></geometry><material><ambient>0.78 0.78 0.83 1</ambient><diffuse>0.78 0.78 0.83 1</diffuse></material></visual>
      </link>
    </model>

    <model name="interior_wall_horizontal_bottom_left">
      <static>true</static>
      <pose>-0.9 -1.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.18 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.18 1.0</size></box></geometry><material><ambient>0.78 0.78 0.83 1</ambient><diffuse>0.78 0.78 0.83 1</diffuse></material></visual>
      </link>
    </model>

    <model name="interior_wall_horizontal_bottom_right">
      <static>true</static>
      <pose>3.6 -1.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.18 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.18 1.0</size></box></geometry><material><ambient>0.78 0.78 0.83 1</ambient><diffuse>0.78 0.78 0.83 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Furniture-like static obstacles -->
    <model name="kitchen_counter_block">
      <static>true</static>
      <pose>5.4 3.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 0.7 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 0.7 0.7</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <model name="sofa_block">
      <static>true</static>
      <pose>4.8 -2.5 0.22 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 0.8 0.44</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.8 0.44</size></box></geometry><material><ambient>0.22 0.36 0.62 1</ambient><diffuse>0.22 0.36 0.62 1</diffuse></material></visual>
      </link>
    </model>

    <model name="table_block">
      <static>true</static>
      <pose>-1.8 2.9 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.1 0.9 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.1 0.9 0.6</size></box></geometry><material><ambient>0.64 0.49 0.35 1</ambient><diffuse>0.64 0.49 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <model name="chair_block">
      <static>true</static>
      <pose>-2.3 1.9 0.22 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.44</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.44</size></box></geometry><material><ambient>0.52 0.38 0.28 1</ambient><diffuse>0.52 0.38 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Column landmarks for lidar/depth mapping -->
    <model name="column_1">
      <static>true</static>
      <pose>2.7 -0.2 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.9</length></cylinder></geometry><material><ambient>0.84 0.76 0.33 1</ambient><diffuse>0.84 0.76 0.33 1</diffuse></material></visual>
      </link>
    </model>

    <model name="column_2">
      <static>true</static>
      <pose>0.0 3.1 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.9</length></cylinder></geometry><material><ambient>0.84 0.76 0.33 1</ambient><diffuse>0.84 0.76 0.33 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Mild ramp for traversal challenge -->
    <model name="hall_ramp">
      <static>true</static>
      <pose>5.4 0.7 0.06 0.0 0.12 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.8 0.12</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.8 0.12</size></box></geometry><material><ambient>0.36 0.36 0.36 1</ambient><diffuse>0.36 0.36 0.36 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>