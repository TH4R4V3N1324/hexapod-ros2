<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tilt_platform">

    <!-- Physics -->
    <physics name="1ms" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Harmonic system plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors"/>
    <!-- IMU and magnetometer sensors only publish when their systems are loaded -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <!-- Gazebo's default engine (DART) uses the lower of the two surfaces' mu -->
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Motorised platform for tilt mode: the deck turns (yaw), rolls and pitches about a point at
         its centre. Command each axis in radians on /platform/yaw, /platform/roll and
         /platform/pitch (gz.msgs.Double), e.g.
         gz topic -t /platform/roll -m gz.msgs.Double -p 'data: 0.15' -->
    <model name="platform">
      <link name="yaw_link">
        <pose>0 0 0.15 0 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="roll_link">
        <pose>0 0 0.15 0 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="deck">
        <pose>0 0 0.15 0 0 0</pose>
        <inertial>
          <mass>10.0</mass>
          <inertia><ixx>1.2</ixx><iyy>1.2</iyy><izz>2.4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>1.2 1.2 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 0.04</size></box></geometry>
          <material>
            <ambient>0.2 0.4 0.7 1</ambient>
            <diffuse>0.2 0.4 0.7 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="yaw_joint" type="revolute">
        <parent>world</parent>
        <child>yaw_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <!-- Velocity control needs an effort limit -->
          <limit><lower>-3.2</lower><upper>3.2</upper><effort>1000000</effort></limit>
        </axis>
      </joint>
      <joint name="roll_joint" type="revolute">
        <parent>yaw_link</parent>
        <child>roll_link</child>
        <axis>
          <xyz>1 0 0</xyz>
          <!-- Velocity control needs an effort limit -->
          <limit><lower>-3.2</lower><upper>3.2</upper><effort>1000000</effort></limit>
        </axis>
      </joint>
      <joint name="pitch_joint" type="revolute">
        <parent>roll_link</parent>
        <child>deck</child>
        <axis>
          <xyz>0 1 0</xyz>
          <!-- Velocity control needs an effort limit -->
          <limit><lower>-3.2</lower><upper>3.2</upper><effort>1000000</effort></limit>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>yaw_joint</joint_name>
        <topic>/platform/yaw</topic>
        <!-- Drive the joint's velocity rather than its torque, so the robot's weight can't sag it -->
        <use_velocity_commands>true</use_velocity_commands>
        <p_gain>8</p_gain>
        <cmd_max>1.5</cmd_max>
        <cmd_min>-1.5</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>roll_joint</joint_name>
        <topic>/platform/roll</topic>
        <!-- Drive the joint's velocity rather than its torque, so the robot's weight can't sag it -->
        <use_velocity_commands>true</use_velocity_commands>
        <p_gain>8</p_gain>
        <cmd_max>1.5</cmd_max>
        <cmd_min>-1.5</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>pitch_joint</joint_name>
        <topic>/platform/pitch</topic>
        <!-- Drive the joint's velocity rather than its torque, so the robot's weight can't sag it -->
        <use_velocity_commands>true</use_velocity_commands>
        <p_gain>8</p_gain>
        <cmd_max>1.5</cmd_max>
        <cmd_min>-1.5</cmd_min>
      </plugin>
    </model>

  </world>
</sdf>
