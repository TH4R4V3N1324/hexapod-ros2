<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    Front cameras, shared by the real and Gazebo models so they stay in the same place.
    Both face forward on the front of the body, the ToF camera below the Pi camera.
      front_depth_camera_link  Arducam ToF camera (B0410): 240x180 depth, 70 deg diagonal FOV, 4 m in far mode
      camera_link              Raspberry Pi Camera Module 3 (standard lens, 66 deg horizontal FOV)
    The ToF camera tilts down so it sees low obstacles closer to the feet.
  -->
  <xacro:property name="camera_x" value="0.085"/>        <!-- front face of the body -->
  <xacro:property name="tof_z" value="0.0"/>
  <xacro:property name="tof_pitch" value="0.1745"/>      <!-- 10 deg down -->
  <xacro:property name="picam_z" value="0.03"/>
  <xacro:property name="picam_pitch" value="0.0"/>

  <xacro:macro name="hexapod_cameras">
    <link name="front_depth_camera_link">
      <visual>
        <geometry><box size="0.01 0.038 0.038"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><box size="0.01 0.038 0.038"/></geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>
    <joint name="front_depth_camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="front_depth_camera_link"/>
      <origin xyz="${camera_x} 0 ${tof_z}" rpy="0 ${tof_pitch} 0"/>
    </joint>

    <link name="camera_link">
      <visual>
        <geometry><box size="0.01 0.025 0.024"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><box size="0.01 0.025 0.024"/></geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="${camera_x} 0 ${picam_z}" rpy="0 ${picam_pitch} 0"/>
    </joint>
  </xacro:macro>

</robot>
