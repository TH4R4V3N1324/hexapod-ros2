<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    RPLIDAR A2M12 mount, shared by the real and Gazebo models so they stay in the same place.
    Change lidar_z when the new body is designed.
  -->
  <xacro:property name="lidar_x" value="0.0"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.05"/>    <!-- above base_link, on top of the body -->
  <xacro:property name="lidar_radius" value="0.038"/>
  <xacro:property name="lidar_height" value="0.041"/>

  <xacro:macro name="hexapod_lidar">
    <link name="lidar_link">
      <visual>
        <geometry><cylinder length="${lidar_height}" radius="${lidar_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder length="${lidar_height}" radius="${lidar_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.19"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
