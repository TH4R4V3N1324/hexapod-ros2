<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    RPLIDAR A2M12 mount, shared by the real and Gazebo models so they stay in the same place.
    Placed as on the V6.1 body (Hexapod_V6.1.step).
  -->
  <xacro:property name="lidar_x" value="0.0"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <!-- Height of the scan plane above base_link (the hip joint plane). On the V6.1 body the lidar
       sits on the lid, centred: lid top 72 mm and hip axis 33.85 mm above the body's base, and the
       A2M12's scan plane 29 mm above its own base: 67 mm. The legs cross it (the top of the
       tibia is level with it when standing), so hexapod_bringup's laser_filters.yaml drops
       everything within 0.38 m and SLAM and Nav2 use /lidar/scan_filtered. -->
  <xacro:property name="lidar_z" value="0.067"/>
  <xacro:property name="lidar_radius" value="0.038"/>
  <xacro:property name="lidar_height" value="0.041"/>

  <xacro:macro name="hexapod_lidar">
    <link name="lidar_link">
      <visual>
        <geometry><cylinder length="${lidar_height}" radius="${lidar_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder length="${lidar_height}" radius="${lidar_radius}"/></geometry>
      </collision>
      <!-- Its mass is in base_link's inertial (hexapod.inertials.xacro); fixed joints are merged into base_link -->
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
      </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
