<?xml version="1.0"?>
<!-- Generated by scripts/mass_properties.py from Hexapod_V6.1.step, edit that instead.
     Whole robot 3.323 kg. Printed parts are at 60% of solid until weighed. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="hexapod_base_inertial">
    <inertial>
      <mass value="1.1082"/>
      <origin xyz="-0.00433 0.00009 0.00993"/>
      <inertia ixx="3.4133e-03" ixy="-1.1081e-06" ixz="-5.7272e-05" iyy="5.8450e-03" iyz="6.0138e-08" izz="7.2937e-03"/>
    </inertial>
  </xacro:macro>

  <!-- link: coxa, femur or tibia; side: left or right -->
  <xacro:macro name="hexapod_leg_inertial" params="link side">
    <xacro:if value="${link == 'coxa' and side == 'left'}">
      <inertial>
        <mass value="0.0934"/>
        <origin xyz="0.02018 0.00006 -0.00074"/>
        <inertia ixx="2.3501e-05" ixy="6.6404e-10" ixz="3.6137e-07" iyy="4.3357e-05" iyz="1.7523e-08" izz="4.4608e-05"/>
      </inertial>
    </xacro:if>
    <xacro:if value="${link == 'coxa' and side == 'right'}">
      <inertial>
        <mass value="0.0934"/>
        <origin xyz="0.02018 -0.00006 -0.00074"/>
        <inertia ixx="2.3501e-05" ixy="-6.6404e-10" ixz="3.6137e-07" iyy="4.3357e-05" iyz="-1.7523e-08" izz="4.4608e-05"/>
      </inertial>
    </xacro:if>
    <xacro:if value="${link == 'femur' and side == 'left'}">
      <inertial>
        <mass value="0.1724"/>
        <origin xyz="0.05000 0.00002 -0.00000"/>
        <inertia ixx="3.3923e-05" ixy="-4.3970e-14" ixz="-4.0729e-07" iyy="2.3291e-04" iyz="-2.4257e-14" izz="2.4153e-04"/>
      </inertial>
    </xacro:if>
    <xacro:if value="${link == 'femur' and side == 'right'}">
      <inertial>
        <mass value="0.1724"/>
        <origin xyz="0.05000 -0.00002 -0.00000"/>
        <inertia ixx="3.3923e-05" ixy="4.3970e-14" ixz="-4.0729e-07" iyy="2.3291e-04" iyz="2.4257e-14" izz="2.4153e-04"/>
      </inertial>
    </xacro:if>
    <xacro:if value="${link == 'tibia' and side == 'left'}">
      <inertial>
        <mass value="0.1034"/>
        <origin xyz="0.07831 -0.00000 0.01279"/>
        <inertia ixx="2.7891e-05" ixy="4.6243e-10" ixz="1.3841e-05" iyy="2.3494e-04" iyz="-2.0572e-10" izz="2.3960e-04"/>
      </inertial>
    </xacro:if>
    <xacro:if value="${link == 'tibia' and side == 'right'}">
      <inertial>
        <mass value="0.1034"/>
        <origin xyz="0.07831 0.00000 0.01279"/>
        <inertia ixx="2.7891e-05" ixy="-4.6243e-10" ixz="1.3841e-05" iyy="2.3494e-04" iyz="2.0572e-10" izz="2.3960e-04"/>
      </inertial>
    </xacro:if>
  </xacro:macro>

</robot>
