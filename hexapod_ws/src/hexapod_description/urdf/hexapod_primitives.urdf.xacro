<robot xmlns:xacro="http://ros.org/wiki/xacro" name="hexapod">

  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="front_depth_width" default="256"/>
  <xacro:arg name="front_depth_height" default="144"/>
  <xacro:arg name="front_depth_rate" default="8"/>

  <!-- ================= CONSTANTS ================= -->
  <xacro:property name="coxa_length" value="0.055"/>
  <xacro:property name="femur_length" value="0.09"/>
  <xacro:property name="tibia_length" value="0.15"/>

  <xacro:property name="coxa_width" value="0.048"/>
  <xacro:property name="coxa_height" value="0.06"/>

  <xacro:property name="femur_radius" value="0.029"/>
  <xacro:property name="tibia_radius" value="0.0225"/>

  <xacro:property name="cscale" value="0.95"/>

  <!-- ================= MATERIALS ================= -->
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>
  <material name="green"><color rgba="0 1 0 1"/></material>
  <material name="blue"><color rgba="0 0 1 1"/></material>
  <material name="yellow"><color rgba="1 1 0 1"/></material>
  <material name="cyan"><color rgba="0 1 1 1"/></material>
  <material name="magenta"><color rgba="1 0 1 1"/></material>

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.18 0.17 0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.18 0.17 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

<!-- ================= LEG LINKS ================= -->
<xacro:macro name="leg" params="name x_offset y_offset yaw colour">

  <!-- COXA -->
  <link name="${name}_coxa">
    <visual>
      <origin xyz="${coxa_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${coxa_length} ${coxa_width} ${coxa_height}"/>
      </geometry>
      <material name="${colour}"/>
    </visual>
    <collision>
      <origin xyz="${coxa_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${coxa_length*cscale} ${coxa_width*cscale} ${coxa_height*cscale}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="${coxa_length/2} 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- FEMUR -->
  <link name="${name}_femur">
    <visual>
      <!-- Cylinder base aligned with joint -->
      <origin xyz="${femur_length/2} 0 0" rpy="0 -1.5708 0"/>
      <geometry>
        <cylinder length="${femur_length}" radius="${femur_radius}"/>
      </geometry>
      <material name="${colour}"/>
    </visual>
    <collision>
      <origin xyz="${femur_length/2} 0 0" rpy="0 -1.5708 0"/>
      <geometry>
        <cylinder length="${femur_length*cscale}" radius="${femur_radius*cscale}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="${femur_length/2} 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- TIBIA -->
  <link name="${name}_tibia">
    <visual>
      <origin xyz="${tibia_length/2} 0 0" rpy="0 -1.5708 0"/>
      <geometry>
        <cylinder length="${tibia_length}" radius="${tibia_radius}"/>
      </geometry>
      <material name="${colour}"/>
    </visual>
    <collision>
      <origin xyz="${tibia_length/2} 0 0" rpy="0 -1.5708 0"/>
      <geometry>
        <cylinder length="${tibia_length*cscale}" radius="${tibia_radius*cscale}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="${tibia_length/2} 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- COXA JOINT -->
  <joint name="${name}_coxa_joint" type="revolute">
    <parent link="base_link"/>
    <child link="${name}_coxa"/>
    <origin xyz="${x_offset} ${y_offset} 0" rpy="0 0 ${yaw}"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
  </joint>

  <!-- FEMUR JOINT -->
  <joint name="${name}_femur_joint" type="revolute">
    <parent link="${name}_coxa"/>
    <child link="${name}_femur"/>
    <origin xyz="${coxa_length} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
  </joint>

  <!-- TIBIA JOINT -->
  <joint name="${name}_tibia_joint" type="revolute">
    <parent link="${name}_femur"/>
    <child link="${name}_tibia"/>
    <origin xyz="${femur_length} 0 0" rpy="0 1.5708 0"/> 
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
  </joint>

  <!-- COXA TRANSMISSION -->
  <transmission name="${name}_coxa_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="${name}_coxa_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="${name}_coxa_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- FEMUR TRANSMISSION -->
  <transmission name="${name}_femur_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="${name}_femur_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="${name}_femur_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- TIBIA TRANSMISSION -->
  <transmission name="${name}_tibia_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="${name}_tibia_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="${name}_tibia_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

</xacro:macro>

  <!-- ================= LEGS ================= -->
  <!-- Front left -->
  <xacro:leg name="leg1" x_offset="0.06733" y_offset="0.0846" yaw="0.5236" colour="red"/>

  <!-- Middle left -->
  <xacro:leg name="leg2" x_offset="0.090" y_offset="0" yaw="0" colour="green"/>

  <!-- Rear left -->
  <xacro:leg name="leg3" x_offset="0.06733" y_offset="-0.0846" yaw="-0.5236" colour="blue"/>

  <!-- Front right -->
  <xacro:leg name="leg4" x_offset="-0.06733" y_offset="-0.0846" yaw="-2.61799" colour="yellow"/>

  <!-- Middle right -->
  <xacro:leg name="leg5" x_offset="-0.090" y_offset="0" yaw="-3.14159" colour="cyan"/>

  <!-- Rear right -->
  <xacro:leg name="leg6" x_offset="-0.06733" y_offset="0.0846" yaw="2.61799" colour="magenta"/>

  <!-- ================= SENSORS ================= -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.05 0"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.05 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>  
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0 0.0846 0" rpy="0 0 1.5708"/>
  </joint>

  <gazebo reference="camera_link">
  <sensor name="camera" type="camera">
    <always_on>true</always_on>
    <update_rate>30</update_rate>
    <camera>
      <horizontal_fov>1.047</horizontal_fov>  <!-- 60 degrees -->
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.01</near>
        <far>100</far>
      </clip>
    </camera>
    <topic>/camera/image</topic>
    <gz_frame_id>camera_link</gz_frame_id>
  </sensor>
</gazebo>

<link name="front_depth_camera_link">
  <visual>
    <geometry><box size="0.03 0.03 0.02"/></geometry>
    <material name="black"/>
  </visual>
  <collision>
    <geometry><box size="0.03 0.03 0.02"/></geometry>
  </collision>
  <inertial>
    <mass value="0.08"/>
    <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
  </inertial>
</link>

<joint name="front_depth_camera_joint" type="fixed">
  <parent link="base_link"/>
  <child link="front_depth_camera_link"/>
  <origin xyz="0.0 0.0846 0.02" rpy="0 0 1.5708"/>
</joint>

<gazebo reference="front_depth_camera_link">
  <sensor name="front_depth_camera" type="depth_camera">
    <always_on>true</always_on>
    <update_rate>$(arg front_depth_rate)</update_rate>
    <camera>
      <horizontal_fov>1.2043</horizontal_fov>
      <image>
        <width>$(arg front_depth_width)</width>
        <height>$(arg front_depth_height)</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.2</near>
        <far>10.0</far>
      </clip>
    </camera>
    <topic>/front_depth</topic>
    <gz_frame_id>front_depth_camera_link</gz_frame_id>
  </sensor>
</gazebo>

<link name="imu_link">
  <visual>
    <geometry><box size="0.015 0.015 0.005"/></geometry>
    <material name="green"/>
  </visual>
  <collision>
    <geometry><box size="0.015 0.015 0.005"/></geometry>
  </collision>
  <inertial>
    <mass value="0.01"/>
    <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
  </inertial>
</link>

<joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
</joint>

<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <topic>/imu</topic>
    <gz_frame_id>imu_link</gz_frame_id>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

<gazebo reference="imu_link">
  <sensor name="mag_sensor" type="magnetometer">
    <always_on>true</always_on>
    <update_rate>50</update_rate>
    <topic>/imu/mag</topic>
    <gz_frame_id>imu_link</gz_frame_id>
  </sensor>
</gazebo>

<link name="lidar_link">
  <visual>
    <geometry><cylinder length="0.04" radius="0.025"/></geometry>
    <material name="black"/>
  </visual>
  <collision>
    <geometry><cylinder length="0.04" radius="0.025"/></geometry>
  </collision>
  <inertial>
    <mass value="0.1"/>
    <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
  </inertial>
</link>

<joint name="lidar_joint" type="fixed">
  <parent link="base_link"/>
  <child link="lidar_link"/>
  <origin xyz="0 0 0.05" rpy="0 0 0"/>  <!-- top of body -->
</joint>

<gazebo reference="lidar_link">
  <sensor name="lidar" type="gpu_lidar">
    <always_on>true</always_on>
    <update_rate>20</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <samples>800</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>        <!-- 1 = 2D lidar, increase for 3D -->
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.2</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </lidar>
    <topic>/lidar/scan</topic>
    <gz_frame_id>lidar_link</gz_frame_id>
  </sensor>
</gazebo>

  <!-- ================= ROS2 CONTROL ================= -->
  <xacro:macro name="ros2_control_joint" params="joint_name">
    <joint name="${joint_name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="HexapodHardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:ros2_control_joint joint_name="leg1_coxa_joint"/>
    <xacro:ros2_control_joint joint_name="leg1_femur_joint"/>
    <xacro:ros2_control_joint joint_name="leg1_tibia_joint"/>
    <xacro:ros2_control_joint joint_name="leg2_coxa_joint"/>
    <xacro:ros2_control_joint joint_name="leg2_femur_joint"/>
    <xacro:ros2_control_joint joint_name="leg2_tibia_joint"/>
    <xacro:ros2_control_joint joint_name="leg3_coxa_joint"/>
    <xacro:ros2_control_joint joint_name="leg3_femur_joint"/>
    <xacro:ros2_control_joint joint_name="leg3_tibia_joint"/>
    <xacro:ros2_control_joint joint_name="leg4_coxa_joint"/>
    <xacro:ros2_control_joint joint_name="leg4_femur_joint"/>
    <xacro:ros2_control_joint joint_name="leg4_tibia_joint"/>
    <xacro:ros2_control_joint joint_name="leg5_coxa_joint"/>
    <xacro:ros2_control_joint joint_name="leg5_femur_joint"/>
    <xacro:ros2_control_joint joint_name="leg5_tibia_joint"/>
    <xacro:ros2_control_joint joint_name="leg6_coxa_joint"/>
    <xacro:ros2_control_joint joint_name="leg6_femur_joint"/>
    <xacro:ros2_control_joint joint_name="leg6_tibia_joint"/>
  </ros2_control>

  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

</robot>