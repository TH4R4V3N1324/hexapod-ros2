<robot xmlns:xacro="http://ros.org/wiki/xacro" name="hexapod">

  <xacro:arg name="controllers_file" default=""/>
  <!-- Waveshare ST3215 at 12 V: 2.94 N·m stall torque, 0.222 s/60° no-load speed -->
  <xacro:property name="servo_effort" value="2.94"/>
  <xacro:property name="servo_velocity" value="4.7"/>
  <xacro:arg name="front_depth_width" default="640"/>
  <xacro:arg name="front_depth_height" default="480"/>
  <xacro:arg name="front_depth_rate" default="8"/>

  <!-- ================= CONSTANTS ================= -->
  <xacro:property name="coxa_length" value="0.055"/>
  <xacro:property name="femur_length" value="0.09"/>
  <xacro:property name="tibia_length" value="0.15"/>

  <xacro:property name="coxa_width" value="0.048"/>
  <xacro:property name="coxa_height" value="0.06"/>

  <xacro:property name="femur_radius" value="0.029"/>
  <xacro:property name="tibia_radius" value="0.0225"/>

  <xacro:property name="cscale" value="0.95"/>

  <!-- Rubber foot at the tibia tip; its bottom sits at tibia_length so the IK leg length is unchanged -->
  <xacro:property name="foot_radius" value="0.012"/>
  <xacro:property name="foot_friction" value="1.5"/>

  <!-- ================= MATERIALS ================= -->
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>
  <material name="green"><color rgba="0 1 0 1"/></material>
  <material name="blue"><color rgba="0 0 1 1"/></material>
  <material name="yellow"><color rgba="1 1 0 1"/></material>
  <material name="cyan"><color rgba="0 1 1 1"/></material>
  <material name="magenta"><color rgba="1 0 1 1"/></material>

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.17 0.18 0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.17 0.18 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

<!-- ================= LEG LINKS ================= -->
<xacro:macro name="leg" params="name x_offset y_offset yaw colour">

  <!-- COXA -->
  <link name="${name}_coxa">
    <visual>
      <origin xyz="${coxa_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${coxa_length} ${coxa_width} ${coxa_height}"/>
      </geometry>
      <material name="${colour}"/>
    </visual>
    <collision>
      <origin xyz="${coxa_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${coxa_length*cscale} ${coxa_width*cscale} ${coxa_height*cscale}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="${coxa_length/2} 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- FEMUR -->
  <link name="${name}_femur">
    <visual>
      <!-- Cylinder base aligned with joint -->
      <origin xyz="${femur_length/2} 0 0" rpy="0 -1.5708 0"/>
      <geometry>
        <cylinder length="${femur_length}" radius="${femur_radius}"/>
      </geometry>
      <material name="${colour}"/>
    </visual>
    <collision>
      <origin xyz="${femur_length/2} 0 0" rpy="0 -1.5708 0"/>
      <geometry>
        <cylinder length="${femur_length*cscale}" radius="${femur_radius*cscale}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="${femur_length/2} 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- TIBIA -->
  <link name="${name}_tibia">
    <visual>
      <origin xyz="${tibia_length/2} 0 0" rpy="0 -1.5708 0"/>
      <geometry>
        <cylinder length="${tibia_length}" radius="${tibia_radius}"/>
      </geometry>
      <material name="${colour}"/>
    </visual>
    <!-- Foot sphere. Left unnamed: the URDF converter only applies mu1/mu2 to collisions named after the link -->
    <collision>
      <origin xyz="${tibia_length - foot_radius} 0 0"/>
      <geometry>
        <sphere radius="${foot_radius}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${tibia_length/2} 0 0" rpy="0 -1.5708 0"/>
      <geometry>
        <cylinder length="${tibia_length*cscale}" radius="${tibia_radius*cscale}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="${tibia_length/2} 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <gazebo reference="${name}_tibia">
    <mu1>${foot_friction}</mu1>
    <mu2>${foot_friction}</mu2>
  </gazebo>

  <!-- COXA JOINT -->
  <joint name="${name}_coxa_joint" type="revolute">
    <parent link="base_link"/>
    <child link="${name}_coxa"/>
    <origin xyz="${x_offset} ${y_offset} 0" rpy="0 0 ${yaw}"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>

  <!-- FEMUR JOINT -->
  <joint name="${name}_femur_joint" type="revolute">
    <parent link="${name}_coxa"/>
    <child link="${name}_femur"/>
    <origin xyz="${coxa_length} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>

  <!-- TIBIA JOINT -->
  <joint name="${name}_tibia_joint" type="revolute">
    <parent link="${name}_femur"/>
    <child link="${name}_tibia"/>
    <origin xyz="${femur_length} 0 0" rpy="0 1.5708 0"/> 
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>

  <!-- COXA TRANSMISSION -->
  <transmission name="${name}_coxa_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="${name}_coxa_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="${name}_coxa_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- FEMUR TRANSMISSION -->
  <transmission name="${name}_femur_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="${name}_femur_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="${name}_femur_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- TIBIA TRANSMISSION -->
  <transmission name="${name}_tibia_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="${name}_tibia_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="${name}_tibia_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

</xacro:macro>

  <!-- ================= LEGS ================= -->
  <!-- Body frame follows REP 103: +x forward, +y left, +z up -->

  <!-- Front right -->
  <xacro:leg name="leg1" x_offset="0.0846" y_offset="-0.06733" yaw="-1.0472" colour="red"/>

  <!-- Middle right -->
  <xacro:leg name="leg2" x_offset="0" y_offset="-0.090" yaw="-1.5708" colour="green"/>

  <!-- Rear right -->
  <xacro:leg name="leg3" x_offset="-0.0846" y_offset="-0.06733" yaw="-2.0944" colour="blue"/>

  <!-- Rear left -->
  <xacro:leg name="leg4" x_offset="-0.0846" y_offset="0.06733" yaw="2.0944" colour="yellow"/>

  <!-- Middle left -->
  <xacro:leg name="leg5" x_offset="0" y_offset="0.090" yaw="1.5708" colour="cyan"/>

  <!-- Front left -->
  <xacro:leg name="leg6" x_offset="0.0846" y_offset="0.06733" yaw="1.0472" colour="magenta"/>

  <!-- ================= SENSORS ================= -->
  

  

  <gazebo reference="camera_link">
  <sensor name="camera" type="camera">
    <always_on>true</always_on>
    <update_rate>15</update_rate>
    <camera>
      <horizontal_fov>1.152</horizontal_fov>  <!-- Pi Camera Module 3 standard lens: 66 deg -->
      <image>
        <width>640</width>
        <height>360</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.01</near>
        <far>100</far>
      </clip>
    </camera>
    <topic>/camera/image</topic>
    <gz_frame_id>camera_link</gz_frame_id>
  </sensor>
</gazebo>





<gazebo reference="front_depth_camera_link">
  <sensor name="front_depth_camera" type="depth_camera">
    <always_on>true</always_on>
    <update_rate>$(arg front_depth_rate)</update_rate>
    <camera>
      <horizontal_fov>1.021</horizontal_fov>  <!-- Arducam ToF: 70 deg diagonal = 58.5 deg horizontal -->
      <image>
        <width>$(arg front_depth_width)</width>
        <height>$(arg front_depth_height)</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>4.0</far>    <!-- far mode -->
      </clip>
    </camera>
    <topic>/front_depth</topic>
    <gz_frame_id>front_depth_camera_link</gz_frame_id>
  </sensor>
</gazebo>

<link name="imu_link">
  <visual>
    <geometry><box size="0.015 0.015 0.005"/></geometry>
    <material name="green"/>
  </visual>
  <collision>
    <geometry><box size="0.015 0.015 0.005"/></geometry>
  </collision>
  <inertial>
    <mass value="0.01"/>
    <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
  </inertial>
</link>

<joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
</joint>

<gazebo reference="imu_link">
  <!-- 1000 Hz (the physics rate): Gazebo's gyro is an instantaneous sample, and the body's
       yaw rate jerks with each footstep, so 100 Hz under-reads turns by ~9%. The real ISM330DHCX
       filters internally, so its 100 Hz readings don't have this problem. -->
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>1000</update_rate>
    <topic>/imu</topic>
    <gz_frame_id>imu_link</gz_frame_id>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

<gazebo reference="imu_link">
  <sensor name="mag_sensor" type="magnetometer">
    <always_on>true</always_on>
    <update_rate>50</update_rate>
    <topic>/imu/mag</topic>
    <gz_frame_id>imu_link</gz_frame_id>
  </sensor>
</gazebo>

<xacro:include filename="$(find hexapod_description)/urdf/hexapod.lidar.xacro"/>
<xacro:hexapod_lidar/>
<xacro:include filename="$(find hexapod_description)/urdf/hexapod.cameras.xacro"/>
<xacro:hexapod_cameras/>


<gazebo reference="lidar_link">
  <sensor name="lidar" type="gpu_lidar">
    <always_on>true</always_on>
    <!-- RPLIDAR A2M12: 10 Hz, 16 kHz sampling (0.225 deg steps), 0.2-12 m -->
    <update_rate>10</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <samples>1600</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>        <!-- 1 = 2D lidar, increase for 3D -->
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.2</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </lidar>
    <topic>/lidar/scan</topic>
    <gz_frame_id>lidar_link</gz_frame_id>
  </sensor>
</gazebo>

  <!-- ================= ROS2 CONTROL ================= -->
  <xacro:include filename="$(find hexapod_description)/urdf/hexapod.ros2_control.xacro"/>
  <xacro:hexapod_ros2_control hardware="gazebo"/>

  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

</robot>