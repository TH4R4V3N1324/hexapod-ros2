<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_hardware_interface</name>
  <version>0.0.0</version>
  <description>ros2_control plugin for the ST3215 bus servos and I2C drivers for the ISM330DHCX IMU and INA226 power monitors</description>
  <maintainer email="152168596+TH4R4V3N1324@users.noreply.github.com">raven</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>gait_core</depend>  <!-- the IK, for hardware_tests/test_leg -->
  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>

  <exec_depend>python3-serial</exec_depend>  <!-- hardware_tests/test_lidar.py -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
