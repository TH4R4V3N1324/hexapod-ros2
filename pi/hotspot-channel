#!/bin/sh
# NetworkManager dispatcher script: keep the hotspot (uap0) on the same channel as the home Wi-Fi
# (wlan0). Both share one radio, which can only use one channel at a time.
[ "$1" = wlan0 ] && [ "$2" = up ] || exit 0

CHANNEL=$(/usr/sbin/iw dev wlan0 info | awk '/channel/ {print $2; exit}')
# The hotspot is 2.4 GHz only (channels 1-14)
[ -n "$CHANNEL" ] && [ "$CHANNEL" -le 14 ] || exit 0

if [ "$CHANNEL" != "$(nmcli -g 802-11-wireless.channel connection show hexapod-hotspot)" ]; then
    nmcli connection modify hexapod-hotspot 802-11-wireless.channel "$CHANNEL"
    nmcli connection up hexapod-hotspot
fi
