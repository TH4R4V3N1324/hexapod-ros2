[Unit]
Description=Start the hexapod robot container (pi/update.sh updates the code)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=@USER@
Environment=HEXAPOD_REPO=@REPO@
ExecStart=/usr/local/bin/hexapod-start.sh
# The first start on a freshly set up Pi builds the image, which can take a while
TimeoutStartSec=1h

[Install]
WantedBy=multi-user.target
